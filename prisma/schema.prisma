generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url = env("DATABASE_URL")
}

// Tabel User (Admin, Developer, Player/User)
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  password    String
  role        String   @default("USER") // USER, DEVELOPER, ADMIN
  studioName  String?
  status      String   @default("APPROVED") // <-- KOLOM BARU BUAT VERIFIKASI
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime? // <-- BARU: terakhir terlihat aktif (buat status online/offline di chat)

  // Relasi-relasi (JANGAN DIHAPUS)
  gamesDeveloper   Game[]          @relation("DeveloperGames")
  purchases        Transaction[]
  sentMessages     ChatMessage[]   @relation("Sender")
  receivedMessages ChatMessage[]   @relation("Receiver")
  reviews          Review[]
}

// Tabel Game
model Game {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Int
  genre       String   @default("Lainnya")
  imageUrl    String?
  videoUrl    String?
  status      String   @default("PUBLISHED") // PUBLISHED, REVIEW, INACTIVE (dikelola admin)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  developerId String
  developer   User     @relation("DeveloperGames", fields: [developerId], references: [id])

  transactions Transaction[]
  reviews      Review[]
}

// Tabel Transaksi (Pembayaran)
model Transaction {
  id        String   @id @default(cuid())
  status    String   @default("PENDING") // PENDING, SUCCESS, FAILED
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])
}

// Tabel Chat (Fitur Chat)
// receiverId KOSONG (null) = pesan GLOBAL CHAT, terisi = pesan PERSONAL.
model ChatMessage {
  id         String   @id @default(cuid())
  content    String
  createdAt  DateTime @default(now())
  isRead     Boolean  @default(false)

  senderId   String
  sender     User     @relation("Sender", fields: [senderId], references: [id])

  receiverId String?
  receiver   User?    @relation("Receiver", fields: [receiverId], references: [id])

  @@index([receiverId, createdAt])
  @@index([senderId, receiverId])
}

// Tabel Ulasan (hanya pemilik game / transaksi SUCCESS yang boleh menulis)
model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1 - 5
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  gameId String
  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
  @@index([gameId, createdAt])
}

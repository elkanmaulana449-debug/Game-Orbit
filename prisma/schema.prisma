generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // url = env("DATABASE_URL") 
}

// Tabel User (Admin, Developer, Player/User)
model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String?
  password    String
  role        String   @default("USER") // USER, DEVELOPER, ADMIN
  studioName  String?  // <-- Kolom baru buat Developer
  createdAt   DateTime @default(now())

  // Relasi-relasi (JANGAN DIHAPUS)
  gamesDeveloper   Game[]          @relation("DeveloperGames")
  purchases        Transaction[]
  sentMessages     ChatMessage[]   @relation("Sender")
  receivedMessages ChatMessage[]   @relation("Receiver")
}

// Tabel Game
model Game {
  id          String   @id @default(cuid())
  title       String
  description String
  price       Int
  imageUrl    String?
  createdAt   DateTime @default(now())

  developerId String
  developer   User     @relation("DeveloperGames", fields: [developerId], references: [id])

  transactions Transaction[]
}

// Tabel Transaksi (Pembayaran)
model Transaction {
  id        String   @id @default(cuid())
  status    String   @default("PENDING") // PENDING, SUCCESS, FAILED
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  gameId String
  game   Game   @relation(fields: [gameId], references: [id])
}

// Tabel Chat (Fitur Chat)
model ChatMessage {
  id         String   @id @default(cuid())
  content    String
  createdAt  DateTime @default(now())
  isRead     Boolean  @default(false)

  senderId   String
  sender     User     @relation("Sender", fields: [senderId], references: [id])

  receiverId String
  receiver   User     @relation("Receiver", fields: [receiverId], references: [id])
}